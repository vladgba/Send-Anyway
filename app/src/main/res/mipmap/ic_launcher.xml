<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.x launchers (no adaptive icons): rounded square, artwork enlarged to fill it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="12dp" />
            <gradient
                android:angle="315"
                android:endColor="#5B4BE0"
                android:startColor="#2E6BE6" />
        </shape>
    </item>
    <!-- The 108dp canvas keeps its art in the middle 48dp: negative insets scale it up. -->
    <item
        android:bottom="-10dp"
        android:drawable="@drawable/ic_launcher_fg"
        android:left="-10dp"
        android:right="-10dp"
        android:top="-10dp" />
</layer-list>
